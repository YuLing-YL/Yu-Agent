# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，绝不入库。
# 代码里只通过 os.environ 读取，配置文件里写的是「环境变量名」而不是密钥本身。

# ---- VLM 后端 ----
OPENAI_API_KEY=
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=

# 阿里云百炼 / DashScope（Qwen-VL），OpenAI 兼容接口
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 本地 vLLM / Ollama（无需 key）
LOCAL_VLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_VLM_API_KEY=EMPTY

# ---- 运行时开关（覆盖 config/default.yaml）----
# YU_AGENT_EXPERIMENT=example
# YU_AGENT_LOG_LEVEL=DEBUG
# YU_AGENT_RUNS_DIR=runs
# YU_AGENT_DRY_RUN=1          # 只规划不执行，安全调试
# YU_AGENT_REQUIRE_APPROVAL=1 # 危险动作强制人工确认
